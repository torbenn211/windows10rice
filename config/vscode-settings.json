{
  "editor.fontFamily": "'Monocraft', Consolas, 'Courier New', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": false,
  "editor.renderLineHighlight": "gutter",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.stickyScroll.enabled": false,
  "workbench.colorTheme": "Default Dark+",
  "workbench.iconTheme": "vs-seti",
  "workbench.tree.indent": 16,
  "workbench.list.smoothScrolling": true,
  "workbench.reduceMotion": "off",
  "terminal.integrated.fontFamily": "Monocraft",
  "terminal.integrated.fontSize": 12,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.cursorBlinking": true,
  "window.titleBarStyle": "custom",
  "window.commandCenter": false,
  "breadcrumbs.enabled": false,
  "explorer.compactFolders": false,
  "files.autoSave": "off",
  "editor.scrollBeyondLastLine": false,
  "workbench.startupEditor": "none",
  "workbench.colorCustomizations": {
    "editor.background": "#12100D",
    "editor.foreground": "#E8E0D2",
    "editorCursor.foreground": "#D98324",
    "editor.selectionBackground": "#49301F",
    "editor.lineHighlightBackground": "#211E19",
    "editorLineNumber.foreground": "#776B5B",
    "editorLineNumber.activeForeground": "#F0A05B",
    "editorIndentGuide.background1": "#302920",
    "editorIndentGuide.activeBackground1": "#6B4428",
    "sideBar.background": "#1B1915",
    "sideBar.foreground": "#D8CEBD",
    "activityBar.background": "#12100D",
    "activityBar.foreground": "#F08A36",
    "statusBar.background": "#D98324",
    "statusBar.foreground": "#12100D",
    "titleBar.activeBackground": "#1B1915",
    "titleBar.activeForeground": "#E8E0D2",
    "tab.activeBackground": "#211E19",
    "tab.activeForeground": "#F0A05B",
    "tab.inactiveBackground": "#1B1915",
    "panel.background": "#171512",
    "focusBorder": "#F08A36",
    "list.activeSelectionBackground": "#49301F",
    "list.activeSelectionForeground": "#FFFFFF",
    "input.background": "#211E19",
    "dropdown.background": "#211E19",
    "terminal.background": "#12100D"
  },
  "editor.cursorStyle": "block",
  "window.menuBarVisibility": "classic",
  "workbench.layoutControl.enabled": false,
  "workbench.activityBar.location": "default",
  "editor.cursorBlinking": "blink"
}