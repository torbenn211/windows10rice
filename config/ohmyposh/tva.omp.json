{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#CFC6B4",
          "template": "["
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "#8FAA78",
          "template": "{{ .UserName }}@{{ .HostName }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#CFC6B4",
          "template": " "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#D98324",
          "template": "{{ .Path }}",
          "options": {
            "style": "folder"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#C9A227",
          "template": " ({{ .HEAD }}{{ if .Working.Changed }}*{{ end }})",
          "options": {
            "fetch_status": true
          }
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#CFC6B4",
          "template": "]$"
        }
      ]
    }
  ]
}